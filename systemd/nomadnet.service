[Unit]
Description=NomadNet node - 868 MHz mesh waterfall page server
After=network-online.target waterfall-collector.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/waterfall/venv/bin/nomadnet --daemon --console
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
